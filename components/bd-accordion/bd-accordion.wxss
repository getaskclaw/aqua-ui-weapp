.bd-accordion{overflow:hidden;width:100%;background:rgba(255,255,255,.74);border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;box-shadow:0 12rpx 30rpx rgba(5,48,65,.07),inset 0 1rpx 0 #fff}.bd-accordion-item+.bd-accordion-item{border-top:1rpx solid var(--stroke)}.bd-accordion-head{display:flex;align-items:center;justify-content:space-between;min-height:94rpx;padding:20rpx 24rpx}.bd-accordion-title{display:flex;align-items:center;gap:14rpx;color:var(--ink);font-size:25rpx;font-weight:720}.bd-accordion-arrow{transition:transform var(--motion-standard) var(--ease-aqua)}.bd-accordion-arrow-on{transform:rotate(90deg)}.bd-accordion-content{padding:0 24rpx 24rpx 68rpx;color:var(--ink-2);font-size:22rpx;line-height:1.65;animation:bd-accordion-reveal var(--motion-standard) var(--ease-aqua) both}.bd-accordion-disabled{opacity:.42}.bd-motion-reduced .bd-accordion-arrow{transition-duration:1ms}.bd-motion-reduced .bd-accordion-content{animation:none}
@keyframes bd-accordion-reveal{from{opacity:0;transform:translateY(-8rpx)}to{opacity:1;transform:translateY(0)}}
