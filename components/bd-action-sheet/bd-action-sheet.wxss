.bd-sheet-overlay{position:fixed;z-index:300;inset:0;display:flex;align-items:flex-end;background:rgba(4,23,36,.46);opacity:0;transition:opacity var(--motion-overlay) var(--ease-aqua)}.bd-sheet{width:100%;padding:16rpx 22rpx calc(22rpx + env(safe-area-inset-bottom));background:linear-gradient(165deg,rgba(248,254,254,.98),rgba(230,247,247,.96));border:1rpx solid rgba(255,255,255,.94);border-radius:44rpx 44rpx 0 0;box-shadow:0 -24rpx 70rpx rgba(4,23,36,.20),inset 0 2rpx 0 #fff;opacity:0;transform:translateY(32rpx);transition:transform var(--motion-overlay) var(--ease-aqua),opacity var(--motion-overlay) var(--ease-aqua)}.bd-motion-open{opacity:1}.bd-motion-open .bd-sheet{opacity:1;transform:translateY(0)}.bd-motion-closing{pointer-events:none;transition-timing-function:var(--ease-aqua-exit)}.bd-motion-closing .bd-sheet{transition-timing-function:var(--ease-aqua-exit)}.bd-motion-reduced,.bd-motion-reduced .bd-sheet{transition-duration:1ms;transform:none}.bd-sheet-handle{width:78rpx;height:8rpx;margin:2rpx auto 16rpx;background:rgba(8,61,79,.16);border-radius:999rpx}.bd-sheet-title{padding:12rpx 20rpx 18rpx;color:var(--ink-3);text-align:center;font-size:21rpx}.bd-sheet-actions{overflow:hidden;background:rgba(255,255,255,.66);border:1rpx solid rgba(255,255,255,.9);border-radius:28rpx}.bd-sheet-action{display:flex;align-items:center;gap:18rpx;min-height:92rpx;padding:18rpx 24rpx;color:var(--ocean-800);font-size:27rpx;font-weight:700}.bd-sheet-action+.bd-sheet-action{border-top:1rpx solid var(--stroke)}.bd-sheet-action view{display:flex;flex-direction:column}.bd-sheet-desc{margin-top:2rpx;color:var(--ink-3);font-size:19rpx;font-weight:500}.bd-sheet-danger{color:var(--danger)}.bd-sheet-disabled{opacity:.36}.bd-sheet-cancel{display:flex;align-items:center;justify-content:center;height:86rpx;margin-top:14rpx;color:var(--ink);background:rgba(255,255,255,.78);border:1rpx solid rgba(255,255,255,.92);border-radius:26rpx;font-size:26rpx;font-weight:720}
