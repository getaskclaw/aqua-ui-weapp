.bd-alert{display:flex;align-items:flex-start;gap:18rpx;width:100%;padding:24rpx;color:var(--info);background:linear-gradient(145deg,rgba(235,250,252,.94),rgba(255,255,255,.80));border:1rpx solid rgba(8,124,165,.15);border-left:7rpx solid currentColor;border-radius:26rpx;box-shadow:0 10rpx 28rpx rgba(5,48,65,.07),inset 0 1rpx 0 #fff}.bd-alert-icon{display:flex;align-items:center;justify-content:center;flex:none;width:58rpx;height:58rpx;background:currentColor;border-radius:20rpx;opacity:.16}.bd-alert-copy{display:flex;flex:1;flex-direction:column}.bd-alert-title{color:var(--ink);font-size:26rpx;font-weight:760}.bd-alert-desc{margin-top:6rpx;color:var(--ink-2);font-size:21rpx;line-height:1.55}.bd-alert-close{color:var(--ink-3);font-size:30rpx;line-height:1}.bd-alert-ok{color:var(--success);border-color:rgba(9,132,95,.15)}.bd-alert-warn{color:var(--warning);border-color:rgba(180,95,18,.15)}.bd-alert-danger{color:var(--danger);border-color:rgba(196,61,78,.15)}
