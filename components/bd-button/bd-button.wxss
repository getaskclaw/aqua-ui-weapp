/* bd-button:主按钮青渐变(p500→p600,按压深一档),ghost/danger 均为
   描边降级形态——danger 不做红实底,避免渔民端误触恐慌。 */
.bd-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-weight: 600;
}

.bd-btn-lg {
  font-size: 36rpx;
  padding: 24rpx 32rpx;
}

.bd-btn-md {
  font-size: 30rpx;
  padding: 16rpx 28rpx;
}

.bd-btn-primary {
  background: linear-gradient(135deg, var(--p500) 0%, var(--p600) 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(10, 160, 180, 0.28);
}

.bd-btn-hover-primary {
  background: linear-gradient(135deg, var(--p600) 0%, var(--p700) 100%);
}

.bd-btn-ghost {
  background: rgba(255, 255, 255, 0.5);
  color: var(--p700);
  border: 2rpx solid var(--p500);
}

.bd-btn-hover-ghost {
  background: rgba(255, 255, 255, 0.78);
}

.bd-btn-danger {
  background: rgba(255, 255, 255, 0.5);
  color: var(--danger);
  border: 2rpx solid var(--danger);
}

.bd-btn-hover-danger {
  background: rgba(176, 0, 32, 0.08);
}

.bd-btn-off {
  opacity: 0.5;
}

/* loading 转圈:双弧描边,primary 白弧、描边形态随文字色 */
.bd-btn-spinner {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 4rpx solid currentColor;
  border-top-color: transparent;
  animation: bd-btn-spin 0.8s linear infinite;
}

@keyframes bd-btn-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
