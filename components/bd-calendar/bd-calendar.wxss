.bd-calendar{padding:26rpx;background:var(--surface-solid);border:1rpx solid var(--stroke);border-radius:34rpx}.bd-calendar-head{display:flex;align-items:center;justify-content:space-between}.bd-calendar-title{color:var(--ink);font-size:27rpx;font-weight:780}.bd-calendar-nav{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;color:var(--ocean-800);background:rgba(139,244,235,.2);border-radius:20rpx;font-size:42rpx}.bd-calendar-week,.bd-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.bd-calendar-week{margin-top:20rpx;color:var(--ink-3);font-size:19rpx;text-align:center}.bd-calendar-grid{margin-top:8rpx;row-gap:6rpx}.bd-calendar-day{display:flex;align-items:center;justify-content:center;height:70rpx;color:var(--ink-2);border-radius:18rpx;font-size:22rpx}.bd-calendar-today{box-shadow:inset 0 0 0 2rpx rgba(11,201,189,.38)}.bd-calendar-selected{color:var(--ocean-950);background:linear-gradient(145deg,var(--aqua-300),var(--aqua-400));font-weight:780;box-shadow:0 8rpx 18rpx rgba(11,201,189,.18)}.bd-calendar-disabled{opacity:.28}.bd-calendar-blank{visibility:hidden}
