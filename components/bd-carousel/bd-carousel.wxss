.bd-carousel{position:relative;overflow:hidden;border:1rpx solid rgba(255,255,255,.84);border-radius:36rpx;box-shadow:0 18rpx 48rpx rgba(4,23,36,.12)}.bd-carousel-swiper,.bd-carousel-item,.bd-carousel-image{width:100%;height:100%}.bd-carousel-item{position:relative}.bd-carousel-caption{position:absolute;left:0;right:0;bottom:0;padding:50rpx 28rpx 28rpx;color:#f4ffff;background:linear-gradient(transparent,rgba(4,23,36,.78))}.bd-carousel-title{font-size:30rpx;font-weight:780}.bd-carousel-desc{margin-top:5rpx;color:rgba(244,255,255,.76);font-size:21rpx}.bd-carousel-dots{position:absolute;right:22rpx;bottom:20rpx;display:flex;gap:8rpx}.bd-carousel-dot{width:10rpx;height:10rpx;background:rgba(255,255,255,.5);border-radius:999rpx;transition:width .2s}.bd-carousel-dot-active{width:28rpx;background:var(--aqua-300)}
