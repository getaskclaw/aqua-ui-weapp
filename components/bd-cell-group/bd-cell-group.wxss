.bd-cell-group-wrap{display:block}.bd-cell-group-inset{margin:0 4rpx}.bd-cell-group-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 12rpx 12rpx}.bd-cell-group-title{color:var(--ink);font-size:25rpx;font-weight:760}.bd-cell-group-desc{margin-left:auto;color:var(--ink-3);font-size:20rpx}.bd-cell-group{overflow:hidden;border:1rpx solid var(--stroke);border-radius:30rpx}.bd-cell-group-solid{background:var(--surface-solid)}.bd-cell-group-glass{background:var(--surface);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px)}.bd-cell-group-tint{background:rgba(216,248,246,.64)}
