.bd-check-row{display:flex;align-items:flex-start;gap:18rpx;padding:10rpx 0}.bd-check-box{display:flex;align-items:center;justify-content:center;flex:none;width:42rpx;height:42rpx;margin-top:1rpx;background:rgba(255,255,255,.72);border:2rpx solid var(--stroke-strong);box-shadow:inset 0 1rpx 0 #fff;transition:background-color var(--motion-fast) var(--ease-aqua),border-color var(--motion-fast) var(--ease-aqua),box-shadow var(--motion-fast) var(--ease-aqua)}.bd-check-rounded{border-radius:13rpx}.bd-check-circle{border-radius:50%}.bd-check-on{background:linear-gradient(135deg,var(--aqua-300),var(--aqua-400));border-color:rgba(7,158,156,.28);box-shadow:0 7rpx 18rpx rgba(7,158,156,.20),inset 0 1rpx 0 #fff}
.bd-check-copy{display:flex;flex-direction:column}.bd-check-label{color:var(--ink);font-size:25rpx;font-weight:680}.bd-check-desc{margin-top:3rpx;color:var(--ink-3);font-size:20rpx}.bd-check-disabled{opacity:.42}
