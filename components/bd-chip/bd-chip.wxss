.bd-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid currentColor;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}
.bd-chip-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }

.bd-chip-ok {
  color: var(--success);
  background: rgba(9, 132, 95, 0.09);
  border-color: rgba(9,132,95,.16);
}

.bd-chip-warn {
  color: var(--warning);
  background: rgba(180, 95, 18, 0.09);
  border-color: rgba(180,95,18,.16);
}

.bd-chip-info {
  color: var(--info);
  background: rgba(8, 124, 165, 0.09);
  border-color: rgba(8,124,165,.15);
}

.bd-chip-neutral {
  color: var(--ink-2);
  background: rgba(40, 75, 90, 0.07);
  border-color: rgba(40,75,90,.12);
}

.bd-chip-danger {
  color: var(--danger);
  background: rgba(196, 61, 78, 0.09);
  border-color: rgba(196,61,78,.15);
}

.bd-chip-inverse {
  color: var(--aqua-300);
  background: rgba(139, 244, 235, 0.08);
  border-color: rgba(139, 244, 235, 0.18);
}
