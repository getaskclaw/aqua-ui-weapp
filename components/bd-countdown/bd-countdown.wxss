.bd-countdown{display:inline-flex;align-items:center;gap:8rpx}.bd-count-unit{display:flex;align-items:center;justify-content:center;min-width:62rpx;height:68rpx;padding:0 10rpx;color:var(--ocean-950);background:radial-gradient(circle at 28% 16%,rgba(255,255,255,.9),transparent 45%),linear-gradient(145deg,rgba(139,244,235,.72),rgba(53,227,213,.48));border:1rpx solid rgba(255,255,255,.84);border-radius:20rpx;box-shadow:0 10rpx 24rpx rgba(7,158,156,.14),inset 0 1rpx 0 #fff;font-size:29rpx;font-weight:820}.bd-count-sep{color:var(--ink-3);font-size:28rpx;font-weight:800}
