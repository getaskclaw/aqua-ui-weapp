.bd-divider{display:flex;align-items:center;width:100%;margin:28rpx 0;color:var(--ink-3)}
.bd-divider-line{height:1rpx;background:var(--stroke-strong);transform:scaleY(.5)}.bd-divider-before,.bd-divider-after{flex:1}.bd-divider-text{padding:0 20rpx;font-size:21rpx;font-weight:650}
.bd-divider-left .bd-divider-before{max-width:48rpx}.bd-divider-right .bd-divider-after{max-width:48rpx}.bd-divider-dashed .bd-divider-line{background:repeating-linear-gradient(90deg,var(--stroke-strong) 0 10rpx,transparent 10rpx 18rpx)}
