<view class="bd-empty">
  <view class="bd-empty-icon"><bd-icon name="{{view.icon}}" size="{{72}}" color="#079e9c" /></view>
  <view class="bd-empty-title">{{view.title}}</view>
  <view wx:if="{{view.desc}}" class="bd-empty-desc">{{view.desc}}</view>
  <view wx:if="{{view.actionText}}" class="bd-empty-action">
    <bd-button variant="ghost" size="md" bindtap="onAction">{{view.actionText}}</bd-button>
  </view>
</view>
