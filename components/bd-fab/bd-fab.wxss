.bd-fab{position:fixed;z-index:120;display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;background:radial-gradient(circle at 28% 12%,rgba(255,255,255,.88),transparent 44%),linear-gradient(135deg,var(--aqua-300),var(--aqua-400) 58%,var(--cyan-500));border:1rpx solid rgba(255,255,255,.78);border-radius:34rpx;box-shadow:0 22rpx 50rpx rgba(7,158,156,.30),inset 0 2rpx 0 rgba(255,255,255,.75);font-size:24rpx;font-weight:760}.bd-fab-right{right:30rpx}.bd-fab-left{left:30rpx}.bd-fab-wide{width:auto;min-width:160rpx;padding:0 28rpx;gap:10rpx}.bd-fab-hover{transform:scale(.96)}.bd-fab-disabled{opacity:.42}
