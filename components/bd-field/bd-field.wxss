.bd-field {
  margin-bottom: 24rpx;
}

.bd-field-label {
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 700;
  margin: 0 0 12rpx 4rpx;
  letter-spacing: .5rpx;
}

.bd-field-star {
  color: var(--danger);
}

.bd-field-hint {
  color: var(--ink-3);
  font-size: 22rpx;
  margin: 10rpx 4rpx 0;
}

.bd-field-error {
  color: var(--danger);
  font-size: 22rpx;
  margin: 10rpx 4rpx 0;
}
