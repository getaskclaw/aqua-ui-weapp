.bd-goods-action{display:flex;align-items:center;gap:14rpx;padding:16rpx;background:rgba(248,253,253,.94);border:1rpx solid rgba(255,255,255,.9);border-radius:32rpx;box-shadow:0 16rpx 46rpx rgba(4,23,36,.14);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px)}.bd-goods-action-fixed{position:fixed;z-index:180;left:20rpx;right:20rpx;bottom:20rpx}.bd-goods-action-safe{padding-bottom:calc(16rpx + env(safe-area-inset-bottom))}.bd-goods-links{display:flex;gap:8rpx}.bd-goods-link{min-width:72rpx;color:var(--ink-3);font-size:18rpx;text-align:center}.bd-goods-icon{position:relative;display:flex;align-items:center;justify-content:center;height:40rpx}.bd-goods-icon text{position:absolute;right:2rpx;top:-8rpx;min-width:24rpx;padding:1rpx 5rpx;color:white;background:var(--danger);border-radius:999rpx;font-size:14rpx}.bd-goods-link-disabled{opacity:.35}.bd-goods-buttons{display:flex;flex:1;overflow:hidden;min-height:72rpx;border-radius:24rpx;font-size:22rpx;font-weight:780}.bd-goods-secondary,.bd-goods-primary{display:flex;flex:1;align-items:center;justify-content:center;text-align:center}.bd-goods-secondary{color:var(--ocean-900);background:rgba(139,244,235,.44)}.bd-goods-primary{color:var(--ocean-950);background:linear-gradient(135deg,var(--aqua-300),var(--cyan-500))}.bd-goods-buttons-disabled{opacity:.45}
