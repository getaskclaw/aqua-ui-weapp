.bd-grid{display:flex;flex-wrap:wrap;overflow:hidden;border-radius:30rpx;background:rgba(255,255,255,.72);border:1rpx solid rgba(255,255,255,.9);box-shadow:inset 0 1rpx 0 #fff}
.bd-grid-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:150rpx;padding:20rpx 10rpx;transition:background 160ms ease}.bd-grid-bordered .bd-grid-cell{border-right:1rpx solid var(--stroke);border-bottom:1rpx solid var(--stroke)}
.bd-grid-hover{background:rgba(139,244,235,.18)}.bd-grid-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:23rpx;background:linear-gradient(145deg,rgba(139,244,235,.34),rgba(255,255,255,.82));box-shadow:inset 0 1rpx 0 #fff}
.bd-grid-label{margin-top:10rpx;color:var(--ink);font-size:22rpx;font-weight:700}.bd-grid-note{margin-top:2rpx;color:var(--ink-3);font-size:17rpx}
