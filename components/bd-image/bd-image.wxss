.bd-image{position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(216,248,246,.72),rgba(236,248,250,.9))}.bd-image-native{display:block;width:100%;height:100%}.bd-image-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(237,248,248,.72)}.bd-image-failed{flex-direction:column;gap:8rpx;color:var(--ink-3);font-size:19rpx}.bd-image-spinner{width:34rpx;height:34rpx;border:4rpx solid rgba(7,158,156,.16);border-top-color:var(--aqua-600);border-radius:50%;animation:bd-image-spin .8s linear infinite}@keyframes bd-image-spin{to{transform:rotate(360deg)}}
