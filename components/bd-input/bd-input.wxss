.bd-input-wrap{display:block;margin-bottom:24rpx}.bd-input-label{margin-bottom:10rpx;color:var(--ink-2);font-size:22rpx;font-weight:720}.bd-input-required{margin-right:6rpx;color:var(--danger)}.bd-input-control{display:flex;align-items:center;min-height:82rpx;padding:0 22rpx;background:rgba(255,255,255,.72);border:1rpx solid var(--stroke);border-radius:24rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.bd-input-native{flex:1;height:82rpx;color:var(--ink);font-size:25rpx}.bd-input-area{box-sizing:border-box;height:176rpx;padding:20rpx 0;line-height:1.55}.bd-input-placeholder{color:var(--ink-3)}.bd-input-clear{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;color:var(--ink-3);font-size:34rpx}.bd-input-help{margin-top:8rpx;color:var(--ink-3);font-size:20rpx}.bd-input-error .bd-input-control{border-color:rgba(196,61,78,.48);box-shadow:0 0 0 5rpx rgba(196,61,78,.07)}.bd-input-error .bd-input-help{color:var(--danger)}.bd-input-disabled{opacity:.55}
