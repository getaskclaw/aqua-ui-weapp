<view class="bd-loading {{vertical ? 'bd-loading-vertical' : ''}}">
  <view wx:if="{{type === 'ring'}}" class="bd-loading-ring" style="width:{{size}}rpx;height:{{size}}rpx;"></view>
  <view wx:else class="bd-loading-dots"><view></view><view></view><view></view></view>
  <text wx:if="{{text}}" class="bd-loading-text">{{text}}</text>
</view>
