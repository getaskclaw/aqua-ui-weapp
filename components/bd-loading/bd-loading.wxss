.bd-loading{display:inline-flex;align-items:center;justify-content:center;gap:14rpx}.bd-loading-vertical{flex-direction:column}.bd-loading-ring{border:4rpx solid rgba(7,158,156,.14);border-top-color:var(--aqua-500);border-radius:50%;animation:bd-loading-spin .8s linear infinite;animation-play-state:var(--motion-play-state,running)}.bd-loading-dots{display:flex;gap:7rpx}.bd-loading-dots view{width:13rpx;height:13rpx;background:var(--aqua-500);border-radius:50%;animation:bd-loading-pulse .9s ease-in-out infinite;animation-play-state:var(--motion-play-state,running)}.bd-loading-dots view:nth-child(2){animation-delay:.15s}.bd-loading-dots view:nth-child(3){animation-delay:.3s}.bd-loading-text{color:var(--ink-2);font-size:22rpx}@keyframes bd-loading-spin{to{transform:rotate(360deg)}}@keyframes bd-loading-pulse{0%,100%{opacity:.25;transform:translateY(0)}50%{opacity:1;transform:translateY(-6rpx)}}
