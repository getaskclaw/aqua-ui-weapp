.bd-overlay{position:fixed;z-index:300;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(4,23,36,.48);opacity:0;transition:opacity var(--motion-overlay) var(--ease-aqua)}
.bd-modal{position:relative;overflow:hidden;width:100%;max-width:650rpx;padding:36rpx;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(232,248,248,.96));border:1rpx solid rgba(255,255,255,.94);border-radius:42rpx;box-shadow:0 36rpx 100rpx rgba(4,23,36,.28),inset 0 2rpx 0 #fff;opacity:0;transform:translateY(12rpx) scale(.975);transition:transform var(--motion-overlay) var(--ease-aqua),opacity var(--motion-overlay) var(--ease-aqua)}
.bd-motion-open{opacity:1}.bd-motion-open .bd-modal{opacity:1;transform:translateY(0) scale(1)}.bd-motion-closing{pointer-events:none;transition-timing-function:var(--ease-aqua-exit)}.bd-motion-closing .bd-modal{transition-timing-function:var(--ease-aqua-exit)}.bd-motion-reduced,.bd-motion-reduced .bd-modal{transition-duration:1ms;transform:none}
.bd-modal-glint{position:absolute;left:14%;right:14%;top:0;height:2rpx;background:linear-gradient(90deg,transparent,#fff,transparent)}.bd-modal-title{color:var(--ink);font-size:35rpx;font-weight:800}.bd-modal-desc{margin-top:10rpx;color:var(--ink-2);font-size:23rpx;line-height:1.6}.bd-modal-content{margin-top:22rpx}.bd-modal-actions{display:flex;gap:14rpx;margin-top:30rpx}.bd-modal-actions bd-button{flex:1}
