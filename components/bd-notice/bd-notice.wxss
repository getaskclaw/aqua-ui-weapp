.bd-notice{display:flex;align-items:center;gap:14rpx;width:100%;min-height:76rpx;padding:16rpx 20rpx;color:var(--info);background:linear-gradient(145deg,rgba(220,246,251,.88),rgba(255,255,255,.68));border:1rpx solid rgba(8,124,165,.14);border-radius:24rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.bd-notice-text{flex:1;color:var(--ink-2);font-size:22rpx;line-height:1.5}.bd-notice-action{font-size:21rpx;font-weight:750}.bd-notice-close{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;background:rgba(8,61,79,.07);border-radius:50%;font-size:28rpx}.bd-notice-ok{color:var(--success);background:rgba(229,249,240,.82);border-color:rgba(9,132,95,.14)}.bd-notice-warn{color:var(--warning);background:rgba(255,246,229,.84);border-color:rgba(180,95,18,.15)}.bd-notice-danger{color:var(--danger);background:rgba(255,238,240,.84);border-color:rgba(196,61,78,.15)}
