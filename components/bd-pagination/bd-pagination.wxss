.bd-pagination{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%}.bd-page-btn{display:flex;align-items:center;justify-content:center;min-width:132rpx;height:70rpx;padding:0 22rpx;color:var(--ocean-800);background:linear-gradient(145deg,rgba(255,255,255,.82),rgba(235,249,249,.68));border:1rpx solid rgba(255,255,255,.92);border-radius:22rpx;box-shadow:0 8rpx 20rpx rgba(5,48,65,.07),inset 0 1rpx 0 #fff;font-size:23rpx;font-weight:720}.bd-page-next{background:linear-gradient(135deg,rgba(139,244,235,.72),rgba(53,227,213,.52))}.bd-page-count{color:var(--ink-3);font-size:23rpx}.bd-page-current{color:var(--ink);font-size:29rpx;font-weight:800}.bd-page-off{opacity:.34}.bd-pagination-disabled{opacity:.42}
