.bd-popup-layer{position:fixed;z-index:320;inset:0;display:flex;background:rgba(4,23,36,.46);opacity:0;transition:opacity var(--motion-overlay) var(--ease-aqua)}.bd-popup-layer-bottom{align-items:flex-end}.bd-popup-layer-top{align-items:flex-start}.bd-popup-layer-center{align-items:center;justify-content:center;padding:36rpx}.bd-popup{box-sizing:border-box;width:100%;max-height:86vh;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(237,249,249,.96));border:1rpx solid rgba(255,255,255,.92);box-shadow:0 30rpx 90rpx rgba(4,23,36,.26);opacity:0;transition:transform var(--motion-overlay) var(--ease-aqua),opacity var(--motion-overlay) var(--ease-aqua)}.bd-popup-bottom{border-bottom:0;transform:translateY(28rpx)}.bd-popup-top{border-top:0;transform:translateY(-28rpx)}.bd-popup-center{max-width:650rpx;transform:translateY(10rpx) scale(.98)}.bd-motion-open{opacity:1}.bd-motion-open .bd-popup{opacity:1;transform:translateY(0) scale(1)}.bd-motion-closing{pointer-events:none;transition-timing-function:var(--ease-aqua-exit)}.bd-motion-closing .bd-popup{transition-timing-function:var(--ease-aqua-exit)}.bd-motion-reduced,.bd-motion-reduced .bd-popup{transition-duration:1ms;transform:none}.bd-popup-round.bd-popup-bottom{border-radius:42rpx 42rpx 0 0}.bd-popup-round.bd-popup-top{border-radius:0 0 42rpx 42rpx}.bd-popup-round.bd-popup-center{border-radius:42rpx}.bd-popup-safe{padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom)}.bd-popup-head{display:flex;align-items:center;min-height:92rpx;padding:0 28rpx;border-bottom:1rpx solid var(--stroke)}.bd-popup-title{color:var(--ink);font-size:28rpx;font-weight:780}.bd-popup-close{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin-left:auto;color:var(--ink-3);font-size:38rpx}.bd-popup-content{overflow:auto;max-height:72vh;padding:28rpx}
