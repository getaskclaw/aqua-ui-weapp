.bd-product{display:flex;gap:22rpx;padding:20rpx;background:var(--surface-solid);border:1rpx solid var(--stroke);border-radius:34rpx;box-shadow:0 14rpx 36rpx rgba(4,23,36,.07)}.bd-product-media{position:relative;flex:none;width:190rpx;height:190rpx}.bd-product-tag{position:absolute;left:10rpx;top:10rpx;padding:5rpx 12rpx;color:var(--ocean-950);background:rgba(139,244,235,.9);border-radius:999rpx;font-size:18rpx;font-weight:760}.bd-product-main{display:flex;flex:1;min-width:0;flex-direction:column}.bd-product-title{overflow:hidden;color:var(--ink);font-size:27rpx;font-weight:780;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.bd-product-desc{display:-webkit-box;overflow:hidden;margin-top:8rpx;color:var(--ink-3);font-size:21rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.bd-product-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:14rpx;margin-top:auto}.bd-product-price{color:var(--ocean-900);font-size:34rpx;font-weight:820}.bd-product-price>text:first-child{margin-right:2rpx;font-size:21rpx}.bd-product-original{margin-left:10rpx;color:var(--ink-3);font-size:19rpx;font-weight:500;text-decoration:line-through}.bd-product-action{flex:none}.bd-product-vertical{display:block}.bd-product-vertical .bd-product-media{width:100%;height:300rpx}.bd-product-vertical .bd-product-main{margin-top:18rpx}.bd-product-disabled{opacity:.52}
