.bd-progress{width:100%}.bd-progress-head{display:flex;justify-content:space-between;margin-bottom:12rpx;color:var(--ink-2);font-size:22rpx;font-weight:650}
.bd-progress-track{position:relative;overflow:hidden;height:18rpx;background:rgba(8,61,79,.08);border:1rpx solid rgba(255,255,255,.8);border-radius:999rpx;box-shadow:inset 0 2rpx 8rpx rgba(4,23,36,.08)}
.bd-progress-small{height:10rpx}.bd-progress-large{height:26rpx}.bd-progress-fill{width:100%;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--aqua-500),var(--cyan-500));box-shadow:inset 0 2rpx 0 rgba(255,255,255,.45);transform-origin:left center;transition:transform var(--motion-standard) var(--ease-aqua);will-change:transform}
.bd-progress-fill-ok{background:linear-gradient(90deg,#14a579,#58d7a9)}.bd-progress-fill-warn{background:linear-gradient(90deg,#d07a28,#f5bd59)}.bd-progress-fill-danger{background:linear-gradient(90deg,#c43d4e,#f17a85)}
