.bd-radio-group{display:flex}.bd-radio-vertical{flex-direction:column;gap:18rpx}.bd-radio-horizontal{flex-wrap:wrap;gap:20rpx 30rpx}.bd-radio-item{display:flex;align-items:flex-start;gap:16rpx}.bd-radio-ring{display:flex;align-items:center;justify-content:center;flex:none;width:42rpx;height:42rpx;margin-top:1rpx;background:rgba(255,255,255,.72);border:2rpx solid var(--stroke-strong);border-radius:50%;box-shadow:inset 0 1rpx 0 #fff}.bd-radio-dot{width:20rpx;height:20rpx;border-radius:50%;transform:scale(0);transition:transform 160ms ease}.bd-radio-on{border-color:var(--aqua-500);box-shadow:0 6rpx 16rpx rgba(7,158,156,.16)}.bd-radio-on .bd-radio-dot{background:linear-gradient(135deg,var(--aqua-400),var(--cyan-500));transform:scale(1)}
.bd-radio-copy{display:flex;flex-direction:column}.bd-radio-label{color:var(--ink);font-size:25rpx;font-weight:680}.bd-radio-desc{margin-top:3rpx;color:var(--ink-3);font-size:20rpx}.bd-radio-disabled{opacity:.42}
