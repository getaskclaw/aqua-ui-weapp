.bd-rate-wrap{display:flex;align-items:center;gap:16rpx}.bd-rate{display:flex;gap:7rpx}.bd-rate-star{color:rgba(8,61,79,.14);line-height:1;text-shadow:inset 0 1rpx 0 #fff;transition:transform 140ms ease,color 140ms ease}.bd-rate-on{color:#f2b84b;text-shadow:0 5rpx 12rpx rgba(180,95,18,.20);transform:scale(1.04)}.bd-rate-label{color:var(--ink-3);font-size:21rpx}.bd-rate-disabled{opacity:.45}
