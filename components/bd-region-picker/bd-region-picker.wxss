.bd-region-label{margin-bottom:10rpx;color:var(--ink-2);font-size:22rpx;font-weight:720}.bd-region-control{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;padding:0 22rpx;color:var(--ink);background:rgba(255,255,255,.72);border:1rpx solid var(--stroke);border-radius:24rpx;font-size:24rpx}.bd-region-control text{color:var(--ink-3);font-size:34rpx}.bd-region-placeholder{color:var(--ink-3)}.bd-region-disabled{opacity:.5}
