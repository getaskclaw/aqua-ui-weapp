.bd-result{display:flex;align-items:center;flex-direction:column;padding:42rpx 30rpx;text-align:center;color:var(--success)}.bd-result-icon{display:flex;align-items:center;justify-content:center;width:128rpx;height:128rpx;background:radial-gradient(circle at 30% 18%,rgba(255,255,255,.94),transparent 44%),linear-gradient(145deg,rgba(139,244,235,.42),rgba(255,255,255,.78));border:1rpx solid rgba(255,255,255,.94);border-radius:44rpx;box-shadow:0 18rpx 42rpx rgba(5,48,65,.11),inset 0 -1rpx 0 rgba(7,158,156,.12)}.bd-result-enter .bd-result-icon{animation:bd-result-arrive var(--motion-standard) var(--ease-aqua) both}.bd-result-title{margin-top:26rpx;color:var(--ink);font-size:34rpx;font-weight:800}.bd-result-desc{max-width:520rpx;margin-top:10rpx;color:var(--ink-2);font-size:22rpx;line-height:1.6}.bd-result-extra{margin-top:12rpx}.bd-result-action{width:280rpx;margin-top:28rpx}.bd-result-warning{color:var(--warning)}.bd-result-error{color:var(--danger)}.bd-result-empty{color:var(--ink-3)}.bd-motion-reduced .bd-result-icon{animation:none}
@keyframes bd-result-arrive{from{opacity:0;transform:translateY(10rpx) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
