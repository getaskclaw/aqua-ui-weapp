.bd-search{display:flex;align-items:center;gap:14rpx;width:100%;height:88rpx;padding:0 22rpx;background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(238,250,250,.92));border:1rpx solid rgba(255,255,255,.92);border-radius:28rpx;box-shadow:0 10rpx 28rpx rgba(5,48,65,.08),inset 0 1rpx 0 #fff}.bd-search-input{flex:1;height:100%;color:var(--ink);font-size:26rpx}.bd-search-clear{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;color:var(--ink-3);background:rgba(8,61,79,.08);border-radius:50%;font-size:30rpx}.bd-search-disabled{opacity:.45}
