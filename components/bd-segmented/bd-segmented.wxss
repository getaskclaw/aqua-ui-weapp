.bd-segmented{width:100%;padding:7rpx;background:rgba(8,61,79,.07);border:1rpx solid rgba(255,255,255,.76);border-radius:26rpx;box-shadow:inset 0 2rpx 8rpx rgba(4,23,36,.06)}.bd-segment-track{position:relative;display:flex;width:100%}.bd-segment-indicator{position:absolute;z-index:0;left:0;top:0;bottom:0;box-sizing:border-box;background:rgba(246,253,253,.96);border:1rpx solid rgba(255,255,255,.9);border-radius:20rpx;box-shadow:0 8rpx 20rpx rgba(5,48,65,.10);transition:transform var(--motion-standard) var(--ease-aqua);will-change:transform}.bd-segment{position:relative;z-index:1;display:flex;flex:1;align-items:center;justify-content:center;min-height:62rpx;padding:10rpx 14rpx;color:var(--ink-3);border-radius:20rpx;font-size:23rpx;font-weight:680;transition:color var(--motion-fast) var(--ease-aqua)}.bd-segment-on{color:var(--ocean-900);font-weight:780}.bd-segment-disabled{opacity:.35}.bd-segmented-disabled{opacity:.42}.bd-motion-reduced .bd-segment-indicator,.bd-motion-reduced .bd-segment{transition-duration:1ms}
