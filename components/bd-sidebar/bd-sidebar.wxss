.bd-sidebar{overflow:hidden;width:190rpx;background:rgba(255,255,255,.62);border:1rpx solid var(--stroke);border-radius:30rpx}.bd-sidebar-item{position:relative;display:flex;align-items:center;min-height:88rpx;padding:0 18rpx;color:var(--ink-2);font-size:23rpx}.bd-sidebar-item+.bd-sidebar-item{border-top:1rpx solid var(--stroke)}.bd-sidebar-mark{width:6rpx;height:30rpx;margin-right:12rpx;border-radius:999rpx;background:transparent}.bd-sidebar-active{color:var(--ocean-900);background:rgba(139,244,235,.28);font-weight:760}.bd-sidebar-active .bd-sidebar-mark{background:linear-gradient(180deg,var(--aqua-400),var(--cyan-500))}.bd-sidebar-badge{margin-left:auto;padding:2rpx 9rpx;color:var(--aqua-600);background:rgba(53,227,213,.12);border-radius:999rpx;font-size:17rpx}.bd-sidebar-disabled{opacity:.42}.bd-sidebar-compact{width:160rpx}.bd-sidebar-compact .bd-sidebar-item{min-height:72rpx}
