.bd-skel-card {
  padding: 22rpx 30rpx;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
}

.bd-skel-row {
  padding: 24rpx 0;
}

.bd-skel-row + .bd-skel-row {
  border-top: 1rpx solid var(--stroke);
}

.bd-skel-block {
  height: 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(8,61,79,.07), rgba(255,255,255,.65), rgba(8,61,79,.07));
  background-size: 200% 100%;
  animation: bd-skel-flow 1.6s ease-in-out infinite;
}

@keyframes bd-skel-flow {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
