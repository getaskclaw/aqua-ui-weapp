/* bd-skeleton:骨架块底色沿用 detections/alerts 既有值(#e3edf2),
   加呼吸动画;玻璃卡包裹复用 .glass(apply-shared)。 */
.bd-skel-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.bd-skel-row {
  padding: 24rpx 0;
}

.bd-skel-row + .bd-skel-row {
  border-top: 1rpx solid rgba(65, 98, 111, 0.12);
}

.bd-skel-block {
  height: 28rpx;
  border-radius: 8rpx;
  background: #e3edf2;
  animation: bd-skel-breathe 1.4s ease-in-out infinite;
}

@keyframes bd-skel-breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
