.bd-skel-card {
  padding: 22rpx 30rpx;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
}

.bd-skeleton {
  position: relative;
  overflow: hidden;
}

.bd-skel-row {
  padding: 24rpx 0;
}

.bd-skel-row + .bd-skel-row {
  border-top: 1rpx solid var(--stroke);
}

.bd-skel-block {
  height: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(8,61,79,.08);
}

.bd-skel-shimmer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(100deg, transparent 25%, rgba(255,255,255,.58) 48%, transparent 72%);
  transform: translate3d(-100%, 0, 0);
  animation: bd-skel-flow 1.6s ease-in-out infinite;
  animation-play-state: var(--motion-play-state, running);
  will-change: transform;
}

@keyframes bd-skel-flow { to { transform: translate3d(100%, 0, 0); } }
