.bd-sku-summary{display:flex;align-items:center;gap:22rpx}.bd-sku-price{color:var(--ocean-900);font-size:42rpx;font-weight:840}.bd-sku-price text{margin-right:3rpx;font-size:23rpx}.bd-sku-note{margin-top:7rpx;color:var(--ink-3);font-size:20rpx}.bd-sku-group{margin-top:28rpx}.bd-sku-label{color:var(--ink);font-size:24rpx;font-weight:760}.bd-sku-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.bd-sku-option{padding:14rpx 22rpx;color:var(--ink-2);background:rgba(255,255,255,.68);border:1rpx solid var(--stroke);border-radius:18rpx;font-size:22rpx}.bd-sku-active{color:var(--ocean-900);background:rgba(139,244,235,.32);border-color:rgba(7,158,156,.32);font-weight:760}.bd-sku-disabled{opacity:.34;text-decoration:line-through}.bd-sku-quantity{display:flex;align-items:center;justify-content:space-between;margin-top:32rpx;padding-top:24rpx;border-top:1rpx solid var(--stroke)}.bd-sku-confirm{margin-top:28rpx}
