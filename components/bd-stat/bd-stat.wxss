.bd-stat{padding:26rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(238,250,250,.76));box-shadow:0 12rpx 30rpx rgba(5,48,65,.08),inset 0 1rpx 0 #fff}
.bd-stat-top,.bd-stat-foot{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.bd-stat-label{color:var(--ink-2);font-size:22rpx;font-weight:650}.bd-stat-icon{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:18rpx;background:rgba(139,244,235,.2)}
.bd-stat-value{margin:16rpx 0 10rpx;color:var(--ink);font-size:48rpx;font-weight:820;line-height:1}.bd-stat-trend{color:var(--success);font-size:20rpx;font-weight:750}.bd-stat-note{color:var(--ink-3);font-size:19rpx}
.bd-stat-ocean{color:var(--inverse);background:radial-gradient(circle at 100% 0,rgba(53,227,213,.22),transparent 48%),linear-gradient(145deg,var(--ocean-800),var(--ocean-950));border-color:rgba(139,244,235,.16)}.bd-stat-ocean .bd-stat-label,.bd-stat-ocean .bd-stat-note{color:rgba(224,251,251,.64)}.bd-stat-ocean .bd-stat-value{color:var(--inverse)}
