.bd-stepper{display:inline-flex;align-items:center;overflow:hidden;padding:6rpx;background:rgba(255,255,255,.70);border:1rpx solid rgba(255,255,255,.92);border-radius:24rpx;box-shadow:0 8rpx 22rpx rgba(5,48,65,.08),inset 0 1rpx 0 #fff}.bd-stepper-btn{display:flex;align-items:center;justify-content:center;width:64rpx;height:58rpx;color:var(--ocean-800);background:rgba(139,244,235,.16);border-radius:18rpx;font-size:36rpx;font-weight:600}.bd-stepper-plus{background:linear-gradient(135deg,var(--aqua-300),var(--aqua-400))}
.bd-stepper-value{min-width:76rpx;text-align:center;color:var(--ink);font-size:28rpx;font-weight:780}.bd-stepper-off{opacity:.28}.bd-stepper-disabled{opacity:.42}
