.bd-steps{display:flex;width:100%}.bd-step{display:flex;color:var(--ink-3)}.bd-steps-horizontal .bd-step{flex:1;flex-direction:column;align-items:center;text-align:center}.bd-step-rail{display:flex;align-items:center;width:100%}.bd-step-node{display:flex;align-items:center;justify-content:center;flex:none;width:44rpx;height:44rpx;margin:auto;color:var(--ink-3);background:rgba(255,255,255,.76);border:2rpx solid var(--stroke-strong);border-radius:50%;font-size:19rpx;font-weight:780}.bd-step-line{flex:1;height:3rpx;background:var(--stroke-strong)}.bd-step-copy{display:flex;flex-direction:column;margin-top:12rpx}.bd-step-title{font-size:22rpx;font-weight:700}.bd-step-desc{margin-top:3rpx;font-size:17rpx}.bd-step-done .bd-step-node,.bd-step-current .bd-step-node{color:var(--ocean-950);background:linear-gradient(135deg,var(--aqua-300),var(--aqua-400));border-color:rgba(7,158,156,.22);box-shadow:0 7rpx 16rpx rgba(7,158,156,.18)}.bd-step-done .bd-step-line{background:var(--aqua-400)}.bd-step-current .bd-step-title{color:var(--ink);font-weight:800}
.bd-steps-vertical{flex-direction:column}.bd-steps-vertical .bd-step{align-items:stretch;min-height:110rpx}.bd-steps-vertical .bd-step-rail{width:44rpx;flex-direction:column}.bd-steps-vertical .bd-step-line{width:3rpx;height:auto}.bd-steps-vertical .bd-step-copy{margin:4rpx 0 22rpx 18rpx;text-align:left}
