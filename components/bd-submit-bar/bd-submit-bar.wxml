<view class="bd-submit {{fixed ? 'bd-submit-fixed' : ''}} {{safeArea ? 'bd-submit-safe' : ''}}"><view class="bd-submit-total"><view><text class="bd-submit-label">{{label}}</text><text class="bd-submit-currency">{{currency}}</text><text class="bd-submit-price">{{price}}</text></view><view wx:if="{{note}}" class="bd-submit-note">{{note}}</view></view><view class="bd-submit-button {{disabled || loading ? 'bd-submit-disabled' : ''}}" bindtap="submit"><view wx:if="{{loading}}" class="bd-submit-spinner"></view>{{loading ? '处理中' : buttonText}}</view></view>
