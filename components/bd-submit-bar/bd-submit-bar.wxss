.bd-submit{display:flex;align-items:center;gap:20rpx;padding:18rpx 20rpx;background:rgba(248,253,253,.98);border:1rpx solid rgba(255,255,255,.92);border-radius:32rpx;box-shadow:0 16rpx 46rpx rgba(4,23,36,.12)}.bd-submit-fixed{position:fixed;z-index:180;left:20rpx;right:20rpx;bottom:20rpx}.bd-submit-safe{padding-bottom:calc(18rpx + env(safe-area-inset-bottom))}.bd-submit-total{flex:1;min-width:0}.bd-submit-label{margin-right:8rpx;color:var(--ink-2);font-size:21rpx}.bd-submit-currency{color:var(--ocean-900);font-size:22rpx;font-weight:760}.bd-submit-price{color:var(--ocean-900);font-size:37rpx;font-weight:840}.bd-submit-note{overflow:hidden;margin-top:3rpx;color:var(--ink-3);font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.bd-submit-button{display:flex;align-items:center;justify-content:center;min-width:210rpx;min-height:76rpx;padding:0 24rpx;color:var(--ocean-950);background:linear-gradient(135deg,var(--aqua-300),var(--cyan-500));border-radius:24rpx;font-size:23rpx;font-weight:800}.bd-submit-disabled{opacity:.45}.bd-submit-spinner{width:26rpx;height:26rpx;margin-right:10rpx;border:4rpx solid rgba(4,23,36,.16);border-top-color:var(--ocean-950);border-radius:50%;animation:bd-submit-spin .8s linear infinite;animation-play-state:var(--motion-play-state,running)}@keyframes bd-submit-spin{to{transform:rotate(360deg)}}
