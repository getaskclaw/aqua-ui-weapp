.bd-switch-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:74rpx}.bd-switch-copy{display:flex;flex:1;flex-direction:column}.bd-switch-label{color:var(--ink);font-size:26rpx;font-weight:700}.bd-switch-desc{margin-top:3rpx;color:var(--ink-3);font-size:20rpx}
.bd-switch{position:relative;flex:none;width:96rpx;height:54rpx;padding:5rpx;background:rgba(8,61,79,.12);border:1rpx solid rgba(8,61,79,.08);border-radius:999rpx;box-shadow:inset 0 3rpx 10rpx rgba(4,23,36,.10);transition:background 180ms ease}.bd-switch-small{width:78rpx;height:44rpx;padding:4rpx}
.bd-switch-knob{width:42rpx;height:42rpx;background:linear-gradient(145deg,#fff,#eaf6f6);border-radius:50%;box-shadow:0 5rpx 14rpx rgba(4,23,36,.24),inset 0 1rpx 0 #fff;transition:transform 180ms ease}.bd-switch-small .bd-switch-knob{width:34rpx;height:34rpx}
.bd-switch-on{background:linear-gradient(135deg,var(--aqua-400),var(--cyan-500));box-shadow:0 8rpx 20rpx rgba(7,158,156,.18),inset 0 2rpx 6rpx rgba(7,158,156,.14)}.bd-switch-on .bd-switch-knob{transform:translateX(42rpx)}.bd-switch-small.bd-switch-on .bd-switch-knob{transform:translateX(34rpx)}.bd-switch-disabled{opacity:.42}
