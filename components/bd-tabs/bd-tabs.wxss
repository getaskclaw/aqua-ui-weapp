.bd-tabs-scroll{width:100%;white-space:nowrap}.bd-tabs{position:relative;display:inline-flex;align-items:center;min-width:100%;gap:8rpx;border-bottom:1rpx solid var(--stroke)}.bd-tabs-centered{justify-content:center}.bd-tabs-indicator{position:absolute;left:0;bottom:-1rpx;height:5rpx;background:linear-gradient(90deg,var(--aqua-500),var(--cyan-500));border-radius:999rpx;box-shadow:0 3rpx 10rpx rgba(7,158,156,.28);transition:transform var(--motion-standard) var(--ease-aqua);will-change:transform}.bd-tab{position:relative;display:flex;align-items:center;gap:8rpx;padding:22rpx 24rpx;color:var(--ink-3);font-size:25rpx;font-weight:680;transition:color var(--motion-fast) var(--ease-aqua)}.bd-tab-on{color:var(--ocean-900);font-weight:780}.bd-tab-badge{padding:2rpx 8rpx;color:var(--info);background:rgba(8,124,165,.09);border-radius:999rpx;font-size:17rpx}.bd-tab-disabled{opacity:.35}.bd-motion-reduced .bd-tabs-indicator,.bd-motion-reduced .bd-tab{transition-duration:1ms}
