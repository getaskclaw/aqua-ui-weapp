.bd-timeline{width:100%}.bd-timeline-item{display:flex;gap:18rpx;min-height:116rpx}.bd-timeline-axis{display:flex;align-items:center;flex-direction:column;width:24rpx}.bd-timeline-dot{flex:none;width:20rpx;height:20rpx;margin-top:11rpx;background:var(--ink-3);border:5rpx solid rgba(255,255,255,.9);border-radius:50%;box-shadow:0 0 0 2rpx rgba(8,61,79,.12)}.bd-timeline-line{width:2rpx;flex:1;background:var(--stroke-strong)}.bd-timeline-card{flex:1;padding:0 0 26rpx}.bd-timeline-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.bd-timeline-title{color:var(--ink);font-size:25rpx;font-weight:720}.bd-timeline-time{color:var(--ink-3);font-size:18rpx}.bd-timeline-desc{display:block;margin-top:6rpx;color:var(--ink-2);font-size:21rpx;line-height:1.5}.bd-timeline-ok .bd-timeline-dot{background:var(--success)}.bd-timeline-info .bd-timeline-dot{background:var(--aqua-500)}.bd-timeline-warn .bd-timeline-dot{background:var(--warning)}.bd-timeline-danger .bd-timeline-dot{background:var(--danger)}
