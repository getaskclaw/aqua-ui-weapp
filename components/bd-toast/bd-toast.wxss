.bd-toast-layer{position:fixed;z-index:500;left:0;right:0;display:flex;justify-content:center;padding:24rpx 36rpx;pointer-events:none}.bd-toast-top{top:calc(24rpx + env(safe-area-inset-top))}.bd-toast-center{top:50%;transform:translateY(-50%)}.bd-toast-bottom{bottom:calc(48rpx + env(safe-area-inset-bottom))}.bd-toast-mask{inset:0;align-items:center;background:rgba(4,23,36,.18);pointer-events:auto}.bd-toast{display:flex;align-items:center;max-width:620rpx;padding:20rpx 26rpx;color:#f4ffff;background:rgba(4,23,36,.9);border:1rpx solid rgba(255,255,255,.15);border-radius:24rpx;box-shadow:0 18rpx 56rpx rgba(4,23,36,.24);font-size:23rpx;line-height:1.45;pointer-events:auto}.bd-toast-dot{flex:none;width:11rpx;height:11rpx;margin-right:14rpx;background:var(--aqua-400);border-radius:50%;box-shadow:0 0 0 6rpx rgba(53,227,213,.12)}.bd-toast-ok .bd-toast-dot{background:var(--success)}.bd-toast-warn .bd-toast-dot{background:var(--warning)}.bd-toast-danger .bd-toast-dot{background:var(--danger)}
