.bd-tooltip-wrap{position:relative;display:inline-flex}.bd-tooltip{position:absolute;z-index:80;left:50%;width:max-content;max-width:360rpx;padding:14rpx 18rpx;color:#eaffff;background:rgba(4,23,36,.96);border:1rpx solid rgba(139,244,235,.16);border-radius:18rpx;box-shadow:0 14rpx 34rpx rgba(4,23,36,.24);font-size:20rpx;line-height:1.45;transform:translateX(-50%)}.bd-tooltip-top{bottom:calc(100% + 18rpx)}.bd-tooltip-bottom{top:calc(100% + 18rpx)}.bd-tooltip-arrow{position:absolute;left:50%;width:16rpx;height:16rpx;background:rgba(4,23,36,.96);transform:translateX(-50%) rotate(45deg)}.bd-tooltip-top .bd-tooltip-arrow{bottom:-8rpx}.bd-tooltip-bottom .bd-tooltip-arrow{top:-8rpx}
