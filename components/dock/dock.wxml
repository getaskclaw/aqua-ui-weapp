<view class="dock {{reducedMotion ? 'bd-motion-reduced' : ''}}">
  <view class="dock-track">
    <view wx:if="{{indicatorVisible}}" class="dock-indicator" style="{{indicatorStyle}}"></view>
  </view>
  <view
    wx:for="{{items}}"
    wx:key="key"
    class="dock-item {{active === item.key ? 'dock-item-on' : ''}}"
    data-url="{{item.url}}"
    bindtap="open"
    hover-class="dock-item-hover"
    aria-role="tab"
    aria-label="{{item.label}}"
    aria-selected="{{active === item.key}}"
  >
    <bd-icon
      name="{{item.icon}}"
      size="{{40}}"
      color="{{active === item.key ? '#041724' : '#607b86'}}"
    />
    <text class="dock-label">{{item.label}}</text>
  </view>
</view>
