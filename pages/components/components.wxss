.count-badge { padding: 8rpx 16rpx; color: var(--ocean-950); background: linear-gradient(145deg, rgba(139,244,235,.92), rgba(255,255,255,.62)); border: 1rpx solid rgba(255,255,255,.8); border-radius: 999rpx; box-shadow: inset 0 1rpx 0 #fff, 0 8rpx 20rpx rgba(7,158,156,.14); font-size: 20rpx; font-weight: 760; letter-spacing: 1rpx; }
.intro { padding: 26rpx 8rpx 58rpx; }
.intro-title { margin-top: 14rpx; color: var(--ink); font-size: 52rpx; font-weight: 820; letter-spacing: -2rpx; }
.intro-copy { max-width: 610rpx; margin-top: 18rpx; color: var(--ink-2); font-size: 25rpx; line-height: 1.7; }
.demo-section { margin-bottom: 62rpx; }
.last-section { margin-bottom: 16rpx; }
.demo-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 22rpx; }
.demo-head > view:first-child { display: flex; align-items: baseline; gap: 14rpx; }
.demo-index { color: var(--aqua-600); font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; }
.demo-note { color: var(--ink-3); font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }
.button-row { display: flex; gap: 16rpx; margin-top: 18rpx; }
.button-disabled { margin-top: 18rpx; }
.chip-cloud { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 0 4rpx 20rpx; }
.tone-grid { display: flex; gap: 18rpx; }
.tone-cell { flex: 1; min-width: 0; }
.tone-line { width: 78rpx; height: 8rpx; margin-top: 28rpx; border-radius: 999rpx; }
.tint-line { background: var(--aqua-500); }
.ocean-line { background: var(--aqua-300); }
.row-tag { color: var(--ink-3); font-size: 20rpx; font-weight: 650; }
.row-line { height: 1rpx; margin: 0 18rpx; background: var(--stroke); transform: scaleY(.5); }
