.control-count{padding:8rpx 15rpx;color:var(--ocean-950);background:linear-gradient(145deg,rgba(139,244,235,.9),rgba(255,255,255,.62));border:1rpx solid rgba(255,255,255,.82);border-radius:999rpx;box-shadow:inset 0 1rpx 0 #fff;font-size:20rpx;font-weight:780}.control-intro{padding:24rpx 8rpx 54rpx}.control-title{max-width:620rpx;margin-top:14rpx;color:var(--ink);font-size:50rpx;font-weight:820;line-height:1.2;letter-spacing:-2rpx}.control-copy{max-width:610rpx;margin-top:18rpx;color:var(--ink-2);font-size:24rpx;line-height:1.7}.control-section{margin-bottom:62rpx}.last-control-section{margin-bottom:18rpx}.control-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 4rpx 22rpx}.control-head>view:first-child{display:flex;align-items:baseline;gap:14rpx}.control-index{color:var(--aqua-600);font-size:18rpx;font-weight:800}.control-note{color:var(--ink-3);font-size:18rpx;font-weight:700}.avatar-row{display:flex;align-items:center;gap:26rpx;padding:12rpx 8rpx}.message-well{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;background:linear-gradient(145deg,rgba(139,244,235,.30),rgba(255,255,255,.86));border:1rpx solid rgba(255,255,255,.94);border-radius:27rpx;box-shadow:0 10rpx 24rpx rgba(5,48,65,.09)}.stat-grid{display:flex;gap:16rpx;margin-bottom:20rpx}.stat-grid bd-stat{flex:1;min-width:0}.progress-gap{margin-top:26rpx}.control-line{height:1rpx;margin:16rpx 0;background:var(--stroke)}.inline-control{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.inline-title{color:var(--ink);font-size:25rpx;font-weight:720}.inline-desc{margin-top:4rpx;color:var(--ink-3);font-size:19rpx}.control-block{margin-top:24rpx}
