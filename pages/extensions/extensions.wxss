.extension-count{padding:8rpx 14rpx;color:var(--aqua-600);background:rgba(139,244,235,.2);border-radius:999rpx;font-size:19rpx;font-weight:760}.extension-intro{padding:22rpx 8rpx 38rpx}.extension-title{margin-top:12rpx;color:var(--ink);font-size:42rpx;font-weight:820;line-height:1.24;letter-spacing:-2rpx}.extension-copy{margin-top:16rpx;color:var(--ink-2);font-size:23rpx;line-height:1.7}.extension-section{margin-top:52rpx}.extension-section>.section-title{margin:0 6rpx 18rpx}.extension-gap{margin-top:20rpx}.extension-line{height:1rpx;margin:0 18rpx;background:var(--stroke)}.sidebar-demo{display:flex;gap:18rpx}.sidebar-result{flex:1;min-width:0;padding:22rpx;background:var(--surface-solid);border:1rpx solid var(--stroke);border-radius:30rpx;color:var(--ink-3);font-size:21rpx}.sidebar-result-title{margin-bottom:6rpx;color:var(--ink);font-size:24rpx;font-weight:760}.sidebar-result bd-image{display:block;margin-top:18rpx}.extension-actions{display:flex;gap:14rpx}.extension-actions bd-button{flex:1}.last-extension-section{padding-bottom:60rpx}.popup-demo-copy{margin-bottom:24rpx;color:var(--ink-2);font-size:23rpx;line-height:1.65}
