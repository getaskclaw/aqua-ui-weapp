.feedback-count{padding:8rpx 15rpx;color:var(--ocean-950);background:linear-gradient(145deg,rgba(139,244,235,.9),rgba(255,255,255,.62));border:1rpx solid rgba(255,255,255,.82);border-radius:999rpx;box-shadow:inset 0 1rpx 0 #fff;font-size:20rpx;font-weight:780}.feedback-intro{padding:24rpx 8rpx 54rpx}.feedback-title{max-width:630rpx;margin-top:14rpx;color:var(--ink);font-size:50rpx;font-weight:820;line-height:1.2;letter-spacing:-2rpx}.feedback-copy{max-width:610rpx;margin-top:18rpx;color:var(--ink-2);font-size:24rpx;line-height:1.7}.motion-control{margin-top:24rpx;padding:18rpx 22rpx;background:rgba(255,255,255,.58);border:1rpx solid rgba(255,255,255,.82);border-radius:24rpx}.feedback-section{margin-bottom:62rpx}.last-feedback-section{margin-bottom:18rpx}.feedback-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 4rpx 22rpx}.feedback-head>view:first-child{display:flex;align-items:baseline;gap:14rpx}.feedback-index{color:var(--aqua-600);font-size:18rpx;font-weight:800}.feedback-note{color:var(--ink-3);font-size:18rpx;font-weight:700}.feedback-stack{display:flex;flex-direction:column;gap:16rpx}.waiting-row{display:flex;align-items:center;justify-content:space-around;gap:24rpx;min-height:100rpx}.countdown-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx}.countdown-title{color:var(--ink);font-size:24rpx;font-weight:720}.countdown-desc{margin-top:4rpx;color:var(--ink-3);font-size:19rpx}.overlay-copy{color:rgba(224,251,251,.72);font-size:23rpx;line-height:1.65}.overlay-actions{display:flex;flex-direction:column;gap:14rpx;margin-top:26rpx}.tooltip-row{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;color:rgba(224,251,251,.68);font-size:21rpx}
