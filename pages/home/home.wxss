.live-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  color: var(--ocean-800);
  background: linear-gradient(145deg, rgba(255,255,255,.78), rgba(224,248,247,.54));
  border: 1rpx solid rgba(255,255,255,.86);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.live-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--aqua-500); box-shadow: 0 0 0 6rpx rgba(11,201,189,.14); }

.hero {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  margin: 6rpx 0 28rpx;
  padding: 54rpx 42rpx 42rpx;
  background:
    radial-gradient(80% 110% at 100% 0%, rgba(139,244,235,.28), transparent 58%),
    linear-gradient(145deg, rgba(255,255,255,.88), rgba(238,250,250,.78));
  border: 1rpx solid rgba(255,255,255,.86);
  border-radius: 48rpx;
  box-shadow:
    0 26rpx 70rpx rgba(5,48,65,.10),
    inset 0 2rpx 0 rgba(255,255,255,.96),
    inset 0 -1rpx 0 rgba(7,158,156,.08);
}
.hero-content { position: relative; z-index: 2; }
.hero-orb { position: absolute; border-radius: 50%; filter: blur(2px); }
.hero-orb-one { width: 300rpx; height: 300rpx; right: -100rpx; top: -70rpx; background: radial-gradient(circle at 35% 35%, rgba(139,244,235,.9), rgba(22,185,230,.14) 62%, transparent 65%); }
.hero-orb-two { width: 180rpx; height: 180rpx; right: 54rpx; bottom: -94rpx; border: 22rpx solid rgba(53,227,213,.16); }
.hero-kicker { display: flex; align-items: center; gap: 10rpx; color: var(--aqua-600); font-size: 21rpx; font-weight: 760; letter-spacing: 2rpx; }
.hero-title { margin-top: 28rpx; color: var(--ink); font-size: 58rpx; font-weight: 820; line-height: 1.13; letter-spacing: -3rpx; }
.hero-copy { max-width: 550rpx; margin-top: 24rpx; color: var(--ink-2); font-size: 25rpx; line-height: 1.72; }
.hero-actions { display: flex; width: 360rpx; margin-top: 36rpx; flex-direction: column; gap: 14rpx; }

.metric-grid { display: flex; gap: 14rpx; margin-bottom: 56rpx; }
.metric-item { flex: 1; padding: 26rpx 20rpx; background: rgba(255,255,255,.68); border: 1rpx solid rgba(255,255,255,.9); border-radius: 28rpx; box-shadow: 0 12rpx 28rpx rgba(5,48,65,.06); }
.metric-value { color: var(--ocean-900); font-size: 42rpx; font-weight: 820; line-height: 1; }
.metric-label { margin-top: 12rpx; color: var(--ink-2); font-size: 23rpx; font-weight: 700; }
.metric-note { margin-top: 2rpx; color: var(--ink-3); font-size: 19rpx; }

.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 22rpx; }
.section-head .section-title { margin-top: 6rpx; }
.compact-head { margin-top: 50rpx; }
.ocean-top { display: flex; align-items: center; justify-content: space-between; }
.ocean-icon { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 28rpx; background: rgba(139,244,235,.1); border: 1rpx solid rgba(139,244,235,.16); }
.ocean-title { margin-top: 38rpx; color: #f2ffff; font-size: 39rpx; font-weight: 760; line-height: 1.3; letter-spacing: -1rpx; }
.ocean-spectrum { display: flex; gap: 8rpx; margin-top: 44rpx; }
.ocean-spectrum view { flex: 1; height: 14rpx; border-radius: 999rpx; }
.ocean-spectrum view:nth-child(1) { background:#0a3a52; }.ocean-spectrum view:nth-child(2) { background:#0d536b; }.ocean-spectrum view:nth-child(3) { background:#079e9c; }.ocean-spectrum view:nth-child(4) { background:#35e3d5; }.ocean-spectrum view:nth-child(5) { background:#8bf4eb; }
.ocean-caption { margin-top: 14rpx; color: rgba(224,251,251,.62); font-size: 19rpx; letter-spacing: 1rpx; }
.row-line { height: 1rpx; margin: 0 18rpx; background: var(--stroke); transform: scaleY(.5); }
