/* Aqua UI — Polar Ocean. Import once from app.wxss. */
page {
  --ocean-950: #041724;
  --ocean-900: #07283b;
  --ocean-800: #0a3a52;
  --ocean-700: #0d536b;
  --aqua-300: #8bf4eb;
  --aqua-400: #35e3d5;
  --aqua-500: #0bc9bd;
  --aqua-600: #079e9c;
  --cyan-500: #16b9e6;
  --canvas: #edf8f8;
  --surface: rgba(255, 255, 255, 0.82);
  --surface-solid: #f8fdfd;
  --surface-soft: rgba(234, 249, 249, 0.78);
  --glass-regular: rgba(246, 253, 253, 0.76);
  --glass-clear: rgba(255, 255, 255, 0.44);
  --glass-edge: rgba(255, 255, 255, 0.92);
  --stroke: rgba(8, 61, 79, 0.10);
  --stroke-strong: rgba(8, 61, 79, 0.18);
  --ink: #092637;
  --ink-2: #284b5a;
  --ink-3: #607b86;
  --inverse: #f4ffff;
  --success: #09845f;
  --warning: #b45f12;
  --danger: #c43d4e;
  --info: #087ca5;

  /* Motion vocabulary. Components may override these on an ancestor. */
  --motion-fast: 140ms;
  --motion-standard: 200ms;
  --motion-overlay: 240ms;
  --ease-aqua: cubic-bezier(.2, .8, .2, 1);
  --ease-aqua-exit: cubic-bezier(.4, 0, 1, 1);

  /* v0.1 compatibility aliases */
  --navy: var(--ocean-900);
  --navy-deep: var(--ocean-950);
  --aqua: var(--aqua-400);
  --p500: var(--aqua-500);
  --p600: var(--aqua-600);
  --p700: #08777b;
  --bg: var(--canvas);
  --card: var(--surface);
  --sub: var(--ink-2);
  --ok: var(--success);
  --warn: var(--warning);

  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

/* Put this class on the page root when the application reduces motion. */
.aqua-reduced-motion {
  --motion-fast: 1ms;
  --motion-standard: 1ms;
  --motion-overlay: 1ms;
}

.mesh {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(100% 48% at 100% 0%, rgba(53, 227, 213, 0.30) 0%, transparent 62%),
    radial-gradient(80% 42% at -10% 20%, rgba(22, 185, 230, 0.18) 0%, transparent 68%),
    radial-gradient(72% 38% at 90% 82%, rgba(139, 244, 235, 0.20) 0%, transparent 70%),
    linear-gradient(165deg, #f5fcfc 0%, #eaf7f7 52%, #e6f3f5 100%);
}

.glass,
.card {
  background: var(--surface);
  -webkit-backdrop-filter: blur(28px) saturate(1.35);
  backdrop-filter: blur(28px) saturate(1.35);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow:
    0 20rpx 56rpx rgba(5, 48, 65, 0.10),
    0 2rpx 8rpx rgba(5, 48, 65, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.hairline {
  height: 1rpx;
  background: var(--stroke);
  transform: scaleY(0.5);
}

.eyebrow {
  color: var(--aqua-600);
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.display-title {
  color: var(--ink);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: -2rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 750;
  letter-spacing: -0.5rpx;
}

.dock-space {
  padding-bottom: 210rpx !important;
}

